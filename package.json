{
  "name": "damian-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Damian's static engineering and photography portfolio",
  "scripts": {
    "dev": "node tools/serve.mjs",
    "prepare:vendor": "node tools/copy-vendor.mjs",
    "images": "node tools/prepare-images.mjs",
    "check": "node tools/check.mjs",
    "test": "node tools/run-tests.mjs",
    "test:images": "node --test tests/images.test.mjs",
    "build": "tsc --noEmit && node tools/build-timeline.mjs",
    "typecheck": "tsc --noEmit",
    "predev": "npm run build",
    "pretest": "npm run build",
    "precheck": "npm run build",
    "render:assembly": "node tools/render-assembly.mjs"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/hanken-grotesk": "5.3.0",
    "@google/model-viewer": "4.4.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/cli": "4.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "gsap": "3.15.0",
    "lenis": "1.3.27",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "three": "0.183.2",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0"
  }
}
